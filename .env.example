PORT=3000

# Internal gateway JWT signing secret (issued after OAuth2 callback)
JWT_HMAC_SECRET=change-me-in-production
JWT_EXPIRES_IN_SECONDS=3600

# MariaDB TypeORM database settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=gatekeeper
DB_PASSWORD=
DB_NAME=gatekeeper
DB_CHARSET=utf8mb4
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Optional Redis URL for cache storage. If empty, in-memory cache is used.
REDIS_URL=redis://localhost:6379

# Allowed CORS origins for browser clients (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Upstream map for /gateway/{namespace}/{version}/...
# namespace can be either:
# 1) versioned map: "orders": { "v1": "...", "v2": "..." }
# 2) direct upstream (version optional in map): "billing": "http://localhost:4002"
ROUTE_MAP={"orders":{"v1":"http://localhost:4001","v2":"http://localhost:4003"},"billing":"http://localhost:4002"}

# FlowAuth OAuth2 SDK client settings
OAUTH2_SERVER=
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_REDIRECT_URI=http://localhost:3000/auth/oauth2/callback
OAUTH2_SCOPES=openid,profile,email

# Optional issuer/audience hint headers for upstream services
OAUTH2_ISSUER=
OAUTH2_AUDIENCE=
